                Credit
            </NavLink>
            <NavLink class="nav-link" href="planned-expenses">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zm-7-5H7v-2h5v2zm3-4H7v-2h9v2z"/></svg>
                Planned Expenses
            </NavLink>
            <NavLink class="nav-link" href="savings-goals">
