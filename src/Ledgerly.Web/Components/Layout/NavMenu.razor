                Debts
            </NavLink>
            <NavLink class="nav-link" href="scenarios">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/></svg>
                Scenarios
            </NavLink>
            <NavLink class="nav-link" href="budget">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z"/></svg>
                Budget
            </NavLink>
            <NavLink class="nav-link" href="credit">
