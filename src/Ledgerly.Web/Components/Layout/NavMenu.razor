@using Ledgerly.Web.Auth
@inject AuthTokenService AuthTokenService
@inject Ledgerly.Web.Services.AuthApiClient AuthApi
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="nav-brand">
    <a href="" style="display:flex; align-items:center; gap:.6rem; text-decoration:none;">
        <img src="/img/LedgerlyLogoTransparent.png" alt="Ledgerly" style="height:44px; width:auto;" />
        <span style="color:#ffffff; font-size:1.25rem; font-weight:700; letter-spacing:.02em;">Ledgerly</span>
    </a>
</div>

<AuthorizeView>
    <Authorized Context="authState">
        <div class="nav-links">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
