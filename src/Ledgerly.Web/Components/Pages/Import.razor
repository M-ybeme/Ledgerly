@page "/import"
@rendermode InteractiveServer
@using Ledgerly.Contracts.Budget
@using Microsoft.AspNetCore.Components.Forms
@inject Ledgerly.Web.Services.TransactionsApiClient TransactionsApi
@inject Ledgerly.Web.Services.BudgetCategoriesApiClient CategoriesApi
@inject NotificationService NotificationService

<PageTitle>Import Transactions — Ledgerly</PageTitle>

<div class="ld-page">
    <div class="ld-page-header">
        <h1 class="ld-page-title">Import Transactions</h1>
        <p class="ld-page-subtitle">Upload a CSV export from your bank to import transactions in bulk.</p>
    </div>

    <!-- Format guide -->
    <div class="ld-card" style="margin-bottom:1.5rem;">
        <div style="font-weight:600; margin-bottom:.5rem;">Expected CSV format</div>
        <code style="font-size:.82rem; background:var(--ld-bg-surface); padding:.4rem .75rem; border-radius:6px; display:block; margin-bottom:.5rem;">
            Date,Description,Amount<br />
            2026-03-01,Paycheck,3200.00<br />
            2026-03-03,Groceries,-85.42
        </code>
        <div style="font-size:.82rem; color:var(--ld-text-secondary);">
            Positive amounts = income. Negative amounts = expenses. Other columns are ignored.
        </div>
    </div>

    <!-- File picker -->
    @if (rows.Count == 0)
    {
        <div class="ld-card ld-import-dropzone" style="margin-bottom:1.5rem;">
            <div style="font-size:2rem; margin-bottom:.5rem;">📂</div>
            <div style="font-weight:600; margin-bottom:.35rem;">Choose a CSV file</div>
            <div style="font-size:.85rem; color:var(--ld-text-secondary); margin-bottom:1rem;">
                Date, Description, Amount columns required
            </div>
            <InputFile OnChange="LoadFile" accept=".csv" style="max-width:300px;" />
            @if (parseError is not null)
            {
                <div class="ld-inline-tip ld-inline-tip--danger" style="margin-top:1rem;">
                    <span>⚠</span><span>@parseError</span>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Category picker -->
        <div class="ld-card" style="margin-bottom:1.5rem; display:flex; gap:1.5rem; align-items:flex-end; flex-wrap:wrap;">
            <div>
                <label class="ld-label">Assign all rows to category</label>
                <RadzenDropDown @bind-Value="selectedCategoryId"
                                Data="@categories"
                                ValueProperty="Id"
                                TextProperty="Name"
                                Placeholder="— select category —"
                                Style="width:220px;" />
            </div>
            <div style="font-size:.85rem; color:var(--ld-text-secondary);">
                You can recategorize individual transactions after import.
            </div>
        </div>

        <!-- Preview table -->
        <div class="ld-card" style="margin-bottom:1.5rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem; flex-wrap:wrap; gap:.5rem;">
                <div>
                    <span style="font-weight:600;">Preview — @rows.Count row@(rows.Count == 1 ? "" : "s") found</span>
                    @if (duplicateCount > 0)
                    {
                        <span style="margin-left:.75rem; font-size:.82rem; color:var(--ld-text-secondary);">
                            (@duplicateCount duplicate@(duplicateCount == 1 ? "" : "s") will be skipped)
                        </span>
                    }
                </div>
                <button class="ld-goal-btn" style="font-size:.82rem;" @onclick="Reset">Choose different file</button>
            </div>

            <div class="ld-import-preview">
                <table>
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" checked="@allSelected"
                                       @onchange="@(e => ToggleAll((bool)e.Value!))" />
                            </th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr class="@(row.Skip ? "ld-import-skip" : "")">
                                <td>
                                    <input type="checkbox" checked="@(!row.Skip)"
                                           @onchange="@(e => row.Skip = !(bool)e.Value!)" />
                                </td>
                                <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                <td>@row.Description</td>
                                <td style="color:@(row.Amount >= 0 ? "var(--rz-success)" : "var(--rz-danger)"); font-weight:600;">
                                    @row.Amount.ToString("C2")
                                </td>
                                <td style="font-size:.78rem; color:var(--ld-text-secondary);">
                                    @if (row.IsDuplicate) { <span>duplicate</span> }
                                    else if (row.Skip) { <span>skipped</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Import action -->
        @if (importError is not null)
        {
            <div class="ld-inline-tip ld-inline-tip--danger" style="margin-bottom:1rem;">
                <span>⚠</span><span>@importError</span>
            </div>
        }

        @if (importedCount > 0)
        {
            <div class="ld-inline-tip ld-inline-tip--info" style="margin-bottom:1rem;">
                <span>✓</span><span><strong>@importedCount transaction@(importedCount == 1 ? "" : "s") imported</strong> successfully.</span>
            </div>
        }

        <div style="display:flex; gap:.75rem;">
            <RadzenButton Text="@($"Import {rows.Count(r => !r.Skip)} Selected")"
                          Icon="upload"
                          ButtonStyle="ButtonStyle.Primary"
                          Disabled="@(selectedCategoryId == Guid.Empty || !rows.Any(r => !r.Skip))"
                          Click="DoImport"
                          IsBusy="importing" />
        </div>
    }
</div>

@code {
    private sealed class ImportRow
    {
        public DateOnly Date;
        public string Description = "";
        public decimal Amount;
        public bool Skip;
        public bool IsDuplicate;
    }

    private List<ImportRow> rows = [];
    private List<BudgetCategoryDto> categories = [];
    private Guid selectedCategoryId;
    private string? parseError;
    private string? importError;
    private bool importing;
    private int importedCount;

    private bool allSelected => rows.All(r => !r.Skip);
    private int duplicateCount => rows.Count(r => r.IsDuplicate);

    protected override async Task OnInitializedAsync()
    {
        try { categories = await CategoriesApi.GetAllAsync(); }
        catch { categories = []; }
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        parseError = null;
        rows = [];
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            var parsed = ParseCsv(content);
            if (parsed.Count == 0)
            {
                parseError = "No valid rows found. Make sure the file has Date, Description, Amount columns.";
                return;
            }
            rows = parsed;
        }
        catch (Exception ex)
        {
            parseError = $"Could not read file: {ex.Message}";
        }
    }

    private static List<ImportRow> ParseCsv(string content)
    {
        var result = new List<ImportRow>();
        var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        if (lines.Length < 2) return result;

        // Find column indexes from header
        var header = SplitCsvLine(lines[0]);
        int dateIdx = -1, descIdx = -1, amtIdx = -1;
        for (int i = 0; i < header.Length; i++)
        {
            var col = header[i].Trim().ToLowerInvariant().Trim('"');
            if (col is "date") dateIdx = i;
            else if (col is "description" or "memo" or "name") descIdx = i;
            else if (col is "amount" or "amt" or "value") amtIdx = i;
        }
        if (dateIdx < 0 || descIdx < 0 || amtIdx < 0) return result;

        for (int i = 1; i < lines.Length; i++)
        {
            var cols = SplitCsvLine(lines[i]);
            if (cols.Length <= Math.Max(dateIdx, Math.Max(descIdx, amtIdx))) continue;

            var dateStr = cols[dateIdx].Trim().Trim('"');
            var desc = cols[descIdx].Trim().Trim('"');
            var amtStr = cols[amtIdx].Trim().Trim('"').Replace("$", "").Replace(",", "");

            if (!DateOnly.TryParse(dateStr, out var date)) continue;
            if (!decimal.TryParse(amtStr, out var amt)) continue;
            if (string.IsNullOrWhiteSpace(desc)) continue;

            result.Add(new ImportRow { Date = date, Description = desc, Amount = amt });
        }

        // Mark duplicates (same date + amount + description)
        var seen = new HashSet<string>();
        foreach (var r in result)
        {
            var key = $"{r.Date}|{r.Amount}|{r.Description}";
            if (!seen.Add(key))
            {
                r.IsDuplicate = true;
                r.Skip = true;
            }
        }

        return result;
    }

    private static string[] SplitCsvLine(string line)
    {
        var cols = new List<string>();
        bool inQuotes = false;
        var current = new System.Text.StringBuilder();
        foreach (var ch in line)
        {
            if (ch == '"') { inQuotes = !inQuotes; }
            else if (ch == ',' && !inQuotes) { cols.Add(current.ToString()); current.Clear(); }
            else { current.Append(ch); }
        }
        cols.Add(current.ToString());
        return [.. cols];
    }

    private void ToggleAll(bool select)
    {
        foreach (var r in rows.Where(r => !r.IsDuplicate))
            r.Skip = !select;
    }

    private void Reset()
    {
        rows = [];
        parseError = null;
        importError = null;
        importedCount = 0;
    }

    private async Task DoImport()
    {
        if (selectedCategoryId == Guid.Empty)
        {
            importError = "Please select a category before importing.";
            return;
        }

        importing = true;
        importError = null;
        importedCount = 0;

        try
        {
            var toImport = rows.Where(r => !r.Skip).ToList();
            int count = 0;
            foreach (var row in toImport)
            {
                await TransactionsApi.CreateAsync(new CreateTransactionRequest(
                    row.Description, Math.Abs(row.Amount), row.Date, selectedCategoryId));
                row.Skip = true;
                count++;
            }
            importedCount = count;
            NotificationService.Notify(NotificationSeverity.Success, "Import complete",
                $"{count} transaction{(count == 1 ? "" : "s")} imported.");
        }
        catch (Exception ex)
        {
            importError = $"Import failed: {ex.Message}";
        }
        finally
        {
            importing = false;
        }
    }
}
