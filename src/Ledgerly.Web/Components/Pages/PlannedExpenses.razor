@page "/planned-expenses"
@rendermode InteractiveServer
@using Ledgerly.Contracts.Budget
@using Ledgerly.Domain.Budget
@inject Ledgerly.Web.Services.PlannedExpensesApiClient Api
@inject Ledgerly.Web.Services.BudgetCategoriesApiClient CategoriesApi
@inject NotificationService NotificationService

<PageTitle>Planned Expenses — Ledgerly</PageTitle>

<RadzenText TextStyle="TextStyle.H4">Planned Expenses</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" style="color:var(--rz-text-secondary-color);" class="rz-mb-4">
    Track expected bills, one-time costs, and recurring payments against what you actually pay.
</RadzenText>

<RadzenCard class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@(editingId.HasValue ? "Edit Expense" : "Add Planned Expense")</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Wrap="FlexWrap.Wrap">
        <div>
            <RadzenLabel Text="Description" />
            <RadzenTextBox @bind-Value="formDescription" Placeholder="e.g. Car insurance" Style="display:block; width:220px;" />
        </div>
        <div>
            <RadzenLabel Text="Expected Amount" />
            <RadzenNumeric @bind-Value="formAmount" TValue="decimal" Min="0.01m" Format="C2" Style="display:block; width:130px;" />
        </div>
        <div>
            <RadzenLabel Text="Due Date" />
            <RadzenDatePicker @bind-Value="formDueDateProxy" DateFormat="yyyy-MM-dd" Style="display:block; width:160px;" />
        </div>
        <div>
            <RadzenLabel Text="Category (optional)" />
            <RadzenDropDown @bind-Value="formCategoryId" Data="@categories" TextProperty="Name" ValueProperty="Id"
                            Placeholder="— none —" AllowClear="true" Style="display:block; width:180px;" />
        </div>
        <div>
            <RadzenLabel Text="Priority" />
            <RadzenDropDown @bind-Value="formPriority" Data="@priorities" TextProperty="Label" ValueProperty="Value"
                            Style="display:block; width:150px;" />
        </div>
        <div style="display:flex; align-items:center; gap:.5rem; padding-bottom:4px;">
            <RadzenCheckBox @bind-Value="formIsRecurring" />
            <RadzenLabel Text="Recurring" />
        </div>
        <RadzenButton Text="@(editingId.HasValue ? "Update" : "Add")" Icon="@(editingId.HasValue ? "save" : "add")"
                      ButtonStyle="ButtonStyle.Primary" Click="@Save" />
        @if (editingId.HasValue)
        {
            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelEdit" />
        }
    </RadzenStack>
</RadzenCard>

@if (expenses is null)
{
    <RadzenText>Loading…</RadzenText>
}
else if (expenses.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No planned expenses yet. Add one above.</RadzenAlert>
}
else
{
    <!-- Mark Paid panel -->
    @if (markingPaidId.HasValue)
    {
        <RadzenCard class="rz-mb-4" style="border:2px solid #6aab3e;">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Mark as Paid</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Wrap="FlexWrap.Wrap">
                <div>
                    <RadzenLabel Text="Actual Amount Paid" />
                    <RadzenNumeric @bind-Value="markActualAmount" TValue="decimal" Min="0" Format="C2" Style="display:block; width:130px;" />
                </div>
                <div>
                    <RadzenLabel Text="Date Paid" />
                    <RadzenDatePicker @bind-Value="markPaidDateProxy" DateFormat="yyyy-MM-dd" Style="display:block; width:160px;" />
                </div>
                <RadzenButton Text="Confirm Paid" Icon="check_circle" ButtonStyle="ButtonStyle.Success" Click="@ConfirmMarkPaid" />
                <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelMarkPaid" />
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenDataGrid Data="@expenses" TItem="PlannedExpenseDto" AllowSorting="true" AllowColumnResize="true">
        <Columns>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Expected">
                <Template Context="e">@e.PlannedAmount.ToString("C2")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Actual">
                <Template Context="e">@(e.ActualAmount.HasValue ? e.ActualAmount.Value.ToString("C2") : "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Due">
                <Template Context="e">@e.DueDate.ToString("yyyy-MM-dd")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Property="CategoryName" Title="Category">
                <Template Context="e">@(e.CategoryName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Status" Width="90px">
                <Template Context="e">
                    @if (e.IsPaid)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Paid" />
                    }
                    else if (e.DueDate < DateOnly.FromDateTime(DateTime.Today))
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Overdue" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Upcoming" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Priority" Width="120px">
                <Template Context="e">
                    @if (e.Priority == ExpensePriority.MustPay)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Must Pay" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Want to Pay" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Recurring" Width="90px">
                <Template Context="e">@(e.IsRecurring ? "Yes" : "No")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlannedExpenseDto" Title="Actions" Sortable="false" Width="160px">
                <Template Context="e">
                    @if (!e.IsPaid)
                    {
                        <RadzenButton Icon="paid" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Click="@(() => StartMarkPaid(e))" class="rz-mr-1" title="Mark paid" />
                    }
                    else
                    {
                        <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => MarkUnpaid(e.Id))" class="rz-mr-1" title="Mark unpaid" />
                    }
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => StartEdit(e))" class="rz-mr-1" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(() => Delete(e.Id))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private List<PlannedExpenseDto>? expenses;
    private List<BudgetCategoryDto> categories = [];

    private sealed record PriorityOption(string Label, ExpensePriority Value);
    private readonly List<PriorityOption> priorities =
    [
        new("Must Pay", ExpensePriority.MustPay),
        new("Want to Pay", ExpensePriority.WantToPay),
    ];

    // form state
    private string formDescription = "";
    private decimal formAmount = 0;
    private DateOnly formDueDate = DateOnly.FromDateTime(DateTime.Today);
    private Guid? formCategoryId;
    private bool formIsRecurring = false;
    private ExpensePriority formPriority = ExpensePriority.MustPay;
    private Guid? editingId;

    // mark paid state
    private Guid? markingPaidId;
    private decimal markActualAmount = 0;
    private DateOnly markPaidDate = DateOnly.FromDateTime(DateTime.Today);

    // RadzenDatePicker needs DateTime?
    private DateTime? formDueDateProxy
    {
        get => formDueDate.ToDateTime(TimeOnly.MinValue);
        set => formDueDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : DateOnly.FromDateTime(DateTime.Today);
    }

    private DateTime? markPaidDateProxy
    {
        get => markPaidDate.ToDateTime(TimeOnly.MinValue);
        set => markPaidDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : DateOnly.FromDateTime(DateTime.Today);
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadCategoriesAsync());
    }

    private async Task LoadAsync()
    {
        try { expenses = await Api.GetAllAsync(); }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Load failed", ex.Message); expenses = []; }
    }

    private async Task LoadCategoriesAsync()
    {
        try { categories = await CategoriesApi.GetAllAsync(); }
        catch { categories = []; }
    }

    private async Task Save()
    {
        try
        {
            if (editingId.HasValue)
            {
                var updated = await Api.UpdateAsync(editingId.Value,
                    new UpdatePlannedExpenseRequest(formDescription, formAmount, formDueDate, formCategoryId, formIsRecurring, formPriority));
                NotificationService.Notify(NotificationSeverity.Success, "Updated", $"\"{updated.Description}\" saved.");
                CancelEdit();
            }
            else
            {
                var created = await Api.CreateAsync(
                    new CreatePlannedExpenseRequest(formDescription, formAmount, formDueDate, formCategoryId, formIsRecurring, formPriority));
                NotificationService.Notify(NotificationSeverity.Success, "Added", $"\"{created.Description}\" added.");
                formDescription = ""; formAmount = 0; formCategoryId = null; formIsRecurring = false; formPriority = ExpensePriority.MustPay;
            }
            await LoadAsync();
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message); }
    }

    private void StartEdit(PlannedExpenseDto e)
    {
        editingId = e.Id;
        formDescription = e.Description;
        formAmount = e.PlannedAmount;
        formDueDate = e.DueDate;
        formCategoryId = e.CategoryId;
        formIsRecurring = e.IsRecurring;
        formPriority = e.Priority;
        markingPaidId = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        formDescription = ""; formAmount = 0; formDueDate = DateOnly.FromDateTime(DateTime.Today);
        formCategoryId = null; formIsRecurring = false; formPriority = ExpensePriority.MustPay;
    }

    private void StartMarkPaid(PlannedExpenseDto e)
    {
        markingPaidId = e.Id;
        markActualAmount = e.PlannedAmount;
        markPaidDate = DateOnly.FromDateTime(DateTime.Today);
        editingId = null;
    }

    private void CancelMarkPaid() => markingPaidId = null;

    private async Task ConfirmMarkPaid()
    {
        if (!markingPaidId.HasValue) return;
        try
        {
            await Api.MarkPaidAsync(markingPaidId.Value, new MarkPaidRequest(markActualAmount, markPaidDate));
            NotificationService.Notify(NotificationSeverity.Success, "Marked paid", "Payment recorded.");
            markingPaidId = null;
            await LoadAsync();
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message); }
    }

    private async Task MarkUnpaid(Guid id)
    {
        try
        {
            await Api.MarkUnpaidAsync(id);
            NotificationService.Notify(NotificationSeverity.Success, "Reverted", "Marked as unpaid.");
            await LoadAsync();
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message); }
    }

    private async Task Delete(Guid id)
    {
        try
        {
            await Api.DeleteAsync(id);
            NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Expense removed.");
            await LoadAsync();
        }
        catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message); }
    }
}
